CREATE TABLE ScheduledTransactionEntity (
    id TEXT NOT NULL PRIMARY KEY,
    accountId TEXT NOT NULL,
    familyId TEXT NOT NULL,
    type TEXT NOT NULL,
    title TEXT NOT NULL,
    category TEXT,
    frequency TEXT NOT NULL,
    fixedAmount INTEGER,
    percentageRate REAL,
    startDate INTEGER NOT NULL,
    endDate INTEGER,
    lastExecuted INTEGER,
    nextExecution INTEGER NOT NULL,
    isPaused INTEGER NOT NULL DEFAULT 0,
    createdBy TEXT NOT NULL,
    createdAt INTEGER NOT NULL,
    updatedAt INTEGER NOT NULL,
    FOREIGN KEY (accountId) REFERENCES AccountEntity(id) ON DELETE CASCADE,
    FOREIGN KEY (familyId) REFERENCES FamilyEntity(id) ON DELETE CASCADE,
    FOREIGN KEY (createdBy) REFERENCES UserEntity(id)
);

CREATE INDEX scheduled_transaction_accountId ON ScheduledTransactionEntity(accountId);
CREATE INDEX scheduled_transaction_familyId ON ScheduledTransactionEntity(familyId);
CREATE INDEX scheduled_transaction_nextExecution ON ScheduledTransactionEntity(nextExecution);

-- Queries
selectAll:
SELECT * FROM ScheduledTransactionEntity;

selectById:
SELECT * FROM ScheduledTransactionEntity WHERE id = ?;

selectByAccountId:
SELECT * FROM ScheduledTransactionEntity WHERE accountId = ?;

selectByFamilyId:
SELECT * FROM ScheduledTransactionEntity WHERE familyId = ?;

selectDue:
SELECT * FROM ScheduledTransactionEntity
WHERE nextExecution <= ? AND isPaused = 0
ORDER BY nextExecution ASC;

insert:
INSERT OR REPLACE INTO ScheduledTransactionEntity(
    id, accountId, familyId, type, title, category, frequency,
    fixedAmount, percentageRate, startDate, endDate, lastExecuted,
    nextExecution, isPaused, createdBy, createdAt, updatedAt
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

update:
UPDATE ScheduledTransactionEntity
SET title = ?, category = ?, frequency = ?, fixedAmount = ?,
    percentageRate = ?, endDate = ?, updatedAt = ?
WHERE id = ?;

updateExecution:
UPDATE ScheduledTransactionEntity
SET lastExecuted = ?, nextExecution = ?, updatedAt = ?
WHERE id = ?;

pause:
UPDATE ScheduledTransactionEntity
SET isPaused = 1, updatedAt = ?
WHERE id = ?;

resume:
UPDATE ScheduledTransactionEntity
SET isPaused = 0, updatedAt = ?
WHERE id = ?;

deleteById:
DELETE FROM ScheduledTransactionEntity WHERE id = ?;
