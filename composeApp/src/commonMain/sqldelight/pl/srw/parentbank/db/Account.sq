CREATE TABLE AccountEntity (
    id TEXT NOT NULL PRIMARY KEY,
    childId TEXT NOT NULL,
    familyId TEXT NOT NULL,
    balance INTEGER NOT NULL,
    isActive INTEGER NOT NULL DEFAULT 1,
    createdAt INTEGER NOT NULL,
    updatedAt INTEGER NOT NULL,
    FOREIGN KEY (childId) REFERENCES UserEntity(id) ON DELETE CASCADE,
    FOREIGN KEY (familyId) REFERENCES FamilyEntity(id) ON DELETE CASCADE
);

CREATE INDEX account_childId ON AccountEntity(childId);
CREATE INDEX account_familyId ON AccountEntity(familyId);

-- Queries
selectAll:
SELECT * FROM AccountEntity;

selectById:
SELECT * FROM AccountEntity WHERE id = ?;

selectByChildId:
SELECT * FROM AccountEntity WHERE childId = ?;

selectByFamilyId:
SELECT * FROM AccountEntity WHERE familyId = ?;

insert:
INSERT OR REPLACE INTO AccountEntity(id, childId, familyId, balance, isActive, createdAt, updatedAt)
VALUES (?, ?, ?, ?, ?, ?, ?);

updateBalance:
UPDATE AccountEntity
SET balance = ?, updatedAt = ?
WHERE id = ?;

update:
UPDATE AccountEntity
SET balance = ?, isActive = ?, updatedAt = ?
WHERE id = ?;

deactivate:
UPDATE AccountEntity
SET isActive = 0, updatedAt = ?
WHERE id = ?;

deleteById:
DELETE FROM AccountEntity WHERE id = ?;
